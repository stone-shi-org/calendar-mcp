# ---------------------------------------------------------------------
# MULTI-ACCOUNT CONFIGURATION (RECOMMENDED FOR MULTIPLE ACCOUNTS PER PROFILE)
# ---------------------------------------------------------------------
# Set CALENDAR_ACCOUNTS as a JSON array of account objects.
# Note: You must quote the JSON string.
#
# CALENDAR_ACCOUNTS='[{"username": "personal@icloud.com", "password": "xxxx-xxxx-xxxx-xxxx", "url": "https://caldav.icloud.com/"}, {"username": "work@icloud.com", "password": "yyyy-yyyy-yyyy-yyyy", "url": "https://caldav.icloud.com/"}]'

# ---------------------------------------------------------------------
# SINGLE-ACCOUNT CONFIGURATION FALLBACK (LEGACY)
# ---------------------------------------------------------------------
# Used if CALENDAR_ACCOUNTS is not defined.
CALENDAR_URL=https://caldav.icloud.com/
CALENDAR_USERNAME=your-apple-id@gmail.com
CALENDAR_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---------------------------------------------------------------------
# MCP SERVER CONFIGURATIONS
# ---------------------------------------------------------------------
# Valid values: stdio | sse | streamable-http (streamable_http is also accepted)
# To run both HTTP transports together on one port, use a comma-separated
# list, e.g. CALENDAR_MCP_TRANSPORT=sse,streamable-http (stdio cannot be
# combined with the others).
CALENDAR_MCP_TRANSPORT=stdio
CALENDAR_MCP_HOST=0.0.0.0
CALENDAR_MCP_PORT=8000

# Streamable HTTP endpoint path, only used when CALENDAR_MCP_TRANSPORT includes streamable-http
CALENDAR_MCP_STREAMABLE_HTTP_PATH=/mcp

# Profile Access Token (generate with generate_profile_token.py)
CALENDAR_PROFILE_TOKEN=
